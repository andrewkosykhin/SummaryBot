#!/bin/bash
# Скопируй в run.sh (он в .gitignore). Секреты — в .env рядом (см. env.example).
set -e
cd "$(dirname "$0")"

docker build -t summarybot:latest .
docker rm -f summarybot 2>/dev/null || true
mkdir -p data && chown 1000:1000 data  # в контейнере бот работает от uid 1000
docker run -d \
  --name summarybot \
  --restart unless-stopped \
  --env-file .env \
  -v "$PWD/data:/data" \
  summarybot:latest

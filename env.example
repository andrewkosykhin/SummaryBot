# Скопируй в .env и заполни. .env в git не попадает.
TELEGRAM_TOKEN=123456:ABC-your-token
ANTHROPIC_API_KEY=sk-ant-your-key
# необязательно: без него голосовые не расшифровываются
OPENAI_API_KEY=sk-your-openai-key

SUMMARY_TIME=21:00
TZ_NAME=Europe/Moscow
MODEL=claude-sonnet-5-5
# VISION_MODEL=claude-sonnet-5-5
# FAST_MODEL=claude-haiku-4-5
# STT_MODEL=gpt-4o-transcribe
# подробность памяти: short | normal | full (full заметно дороже)
MEMORY_DETAIL=normal
# серия фото от автора разбирается одной пачкой после N секунд тишины
PHOTO_BATCH_WAIT=10
# сколько фото из серии смотреть (альбом — всегда целиком)
MAX_BATCH_PHOTOS=10
DB_PATH=/data/db.sql
